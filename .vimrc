" Minimal sensible vimrc (fallback when nvim is not available)

syntax on
filetype plugin indent on

set number
set relativenumber
set cursorline

set expandtab
set tabstop=4
set shiftwidth=4
set smartindent

set ignorecase
set smartcase
set incsearch
set hlsearch

set wildmenu
set hidden
set nobackup
set nowritebackup
set noswapfile

set clipboard=unnamed
set mouse=a
set scrolloff=5
set signcolumn=yes

let mapleader=" "
